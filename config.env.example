# Copy this file to config.env or run ./siri-remote setup.
# Plain KEY=VALUE data, not shell code. All timing values are in milliseconds.

# Bluetooth connection. Setup saves the remote's stable identity here.
REMOTE_IDENTITY=
ADAPTER=hci0

# Button timing
# Ignore a new press of the same button briefly after release; 0 disables debounce.
BUTTON_DEBOUNCE_MS=50
# A configured long action fires at this threshold, without also sending the short action.
# With a long action enabled, a short click fires on release before this threshold.
# Exception: matching short/long bindings bypass this timer when double click is off.
LONG_PRESS_MS=300
# Only affects buttons with KEY_*_DOUBLE enabled: their single click waits this
# long after release. A second short click within the window sends only the double.
# Must exceed BUTTON_DEBOUNCE_MS when any double-click action is enabled.
DOUBLE_CLICK_MS=300

# Directional button repeat: initial delay, then interval between repeats.
REPEAT_ENABLED=true
REPEAT_DELAY_MS=450
REPEAT_INTERVAL_MS=120

# Touch navigation
# continuous emits steps while moving; release emits a direction when lifting.
TOUCH_MODE=continuous
# Movement threshold and minimum time between emitted steps.
TOUCH_STEP=18
TOUCH_INTERVAL_MS=90
# Delay initial output while preserving movement; short gestures resolve on release.
TOUCH_SETTLE_MS=50
# Ignore light contact: start tracking when pressure reaches this threshold (1..255).
# Discard earlier movement. Lower ON if light gestures are not recognized.
TOUCH_PRESSURE_ON=10
# Below OFF, finish the gesture at the last reliable position.
# OFF <= ON: the gap prevents small pressure fluctuations from interrupting tracking.
# Resuming requires ON and sets a new origin. ON=1 and OFF=1 disable the filter.
TOUCH_PRESSURE_OFF=4
# Keep a gesture on one axis; reversal requires TOUCH_STEP plus TOUCH_REVERSE_MARGIN.
TOUCH_AXIS_LOCK=true
TOUCH_REVERSE_MARGIN=4
# Movement scaling and vertical direction.
TOUCH_GAIN_X=1.0
TOUCH_GAIN_Y=1.0
TOUCH_INVERT_Y=false

# Key bindings (evdev KEY_* names)
# Optional Back/TV/Siri long and double actions accept NONE or chords joined by +.
# KEY_SIRI also accepts NONE or chords. Double-click actions are disabled by default.
# Without a long or double action, Back/TV/Siri send their single action on press.
# Matching short/long bindings hold the key (or chord) from press to release.
# For Back/TV/Siri this requires KEY_*_DOUBLE=NONE; Center has no double click.
# In this mode LONG_PRESS_MS is ignored: the app decides its long-press threshold.

# Directional ring and touch navigation
KEY_UP=KEY_UP
KEY_DOWN=KEY_DOWN
KEY_LEFT=KEY_LEFT
KEY_RIGHT=KEY_RIGHT

# Center: identical bindings hold the key from press to release.
# This sends key DOWN immediately and key UP on release; LONG_PRESS_MS is ignored.
# The receiving app decides its own long-press threshold (e.g. for a video menu).
# Changing LONG_PRESS_MS does not change that app-controlled threshold.
# KEY_CENTER_LONG=NONE disables long press and sends the short action on press.
# Different bindings select short on release or long at LONG_PRESS_MS.
KEY_CENTER=KEY_ENTER
KEY_CENTER_LONG=KEY_ENTER

# Back
KEY_BACK=KEY_ESC
KEY_BACK_LONG=NONE
KEY_BACK_DOUBLE=NONE

# TV
KEY_TV=KEY_HOME
KEY_TV_LONG=KEY_F10
KEY_TV_DOUBLE=NONE

# Siri (key output only; does not enable voice recognition)
KEY_SIRI=KEY_F12
KEY_SIRI_LONG=NONE
KEY_SIRI_DOUBLE=NONE

# Playback and volume
KEY_PLAYPAUSE=KEY_PLAYPAUSE
KEY_VOLUMEUP=KEY_VOLUMEUP
KEY_VOLUMEDOWN=KEY_VOLUMEDOWN
KEY_MUTE=KEY_MUTE
